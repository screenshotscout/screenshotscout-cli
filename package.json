{
  "name": "@screenshotscout/cli",
  "version": "0.1.0",
  "description": "Official command-line interface for the Screenshot Scout screenshot API.",
  "type": "module",
  "bin": {
    "screenshotscout": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"const fs = require('node:fs'); fs.rmSync('dist', { force: true, recursive: true });\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "author": "Oleksii Velykyi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/screenshotscout/screenshotscout-cli.git"
  },
  "homepage": "https://screenshotscout.com/docs/cli",
  "bugs": {
    "url": "https://github.com/screenshotscout/screenshotscout-cli/issues"
  },
  "keywords": [
    "cli",
    "command-line",
    "screenshot",
    "screenshot-api",
    "screenshotscout",
    "url-to-image",
    "webpage-screenshot",
    "website-screenshot"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@screenshotscout/sdk": "0.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
